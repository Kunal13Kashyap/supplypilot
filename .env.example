# ProcureAI environment
# Copy to .env — never commit secrets.

DEMO_MODE=true
MOCK_LLM=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth (demo only — replace in any real deployment)
JWT_SECRET=change-me-in-any-non-demo-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=procureai
POSTGRES_USER=procureai
POSTGRES_PASSWORD=procureai
DATABASE_URL=postgresql+asyncpg://procureai:procureai@postgres:5432/procureai

# Redis
REDIS_URL=redis://redis:6379/0

# LLM — leave empty to force MockLLMProvider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30

# Business rules (overridable; also seeded in DB)
APPROVAL_AMOUNT_MEDIUM=1000
APPROVAL_AMOUNT_HIGH=5000
TARGET_STOCK_DEFAULT=200

# Frontend (browser talks to published API port)
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
